# Sao chép file này thành .env rồi chỉnh sửa
API_KEY=my-super-secret-key-123
PORT=3000
# Sau bao nhiêu giây không nhận dữ liệu thì coi là Offline
OFFLINE_TIMEOUT_SECONDS=15
# Chu kỳ tự làm mới của dashboard (giây)
REFRESH_INTERVAL_SECONDS=3
# Số bản ghi tối đa giữ lại
MAX_RECORDS=2000
# Đặt false để chỉ lưu trong RAM (không ghi file data/data.json)
PERSIST=true
